# Copy to .env and fill in. Values below match the local docker-compose stack,
# so the defaults work as-is for development.

NODE_ENV=development

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://codevault:codevault@localhost:5432/codevault

# --- Object storage ---------------------------------------------------------
# Local: SeaweedFS from docker-compose. Production: R2's account endpoint,
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com — presigned URLs do not work
# against a custom domain.
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_ACCESS_KEY_ID=codevault
S3_SECRET_ACCESS_KEY=codevaultsecret
S3_FORCE_PATH_STYLE=true

BUCKET_PUBLIC=codevault-reports-public
BUCKET_INTERNAL=codevault-reports-internal
BUCKET_QUARANTINE=codevault-reports-quarantine

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-replace-me-with-48-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Changing PASSKEY_RP_ID invalidates every enrolled credential. Pick it before
# the first enrollment. Must be the registrable domain, without a scheme.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=CodeVault

# --- Client (bundled into the browser — public values only) ------------------
VITE_CONTENT_URL=http://localhost:8333
