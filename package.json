{
  "name": "manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "build:migrate": "bun build ./scripts/migrate.ts --target=node --outfile=.output/migrate.mjs",
    "db:deploy": "node .output/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storage:bootstrap": "bun run scripts/storage-bootstrap.ts",
    "dev:up": "docker compose up -d --wait && bun run db:migrate && bun run storage:bootstrap",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && bun run dev:up",
    "admin:provision": "bun run scripts/admin-provision.ts",
    "brand:assets": "bun run scripts/brand-assets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.984.0",
    "@aws-sdk/s3-request-presigner": "3.984.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/passkey": "1.6.23",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@t3-oss/env-core": "0.13.11",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/router-plugin": "1.168.18",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "file-type": "22.0.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "postgres": "3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "jsdom": "^28",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
